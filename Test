if not getgenv().Evade_Event then
    getgenv().Evade_Event = {
        AutoGetBike = false,
        AutoCollectDonut = false,
        AntiAfk = false
    }
end

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local LocalPlayer = Players.LocalPlayer

local BikeEvent = game:GetService("ReplicatedStorage").OddStuffIntegrationModule.Assets.Remotes["Bike::ForceStateEvent"]

local function StartAutoGetBike()
    task.spawn(function()
        while true do
            if getgenv().Evade_Event.AutoGetBike then
                pcall(function()
                    firesignal(BikeEvent.OnClientEvent, true)
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            hum.Jump = true
                        end
                    end
                end)
            end
            task.wait(0.1)
        end
    end)
end

local function StartAutoCollectDonut()
    task.spawn(function()
        while true do
            if getgenv().Evade_Event.AutoCollectDonut then
                pcall(function()
                    local char = LocalPlayer.Character
                    local root = char and char:FindFirstChild("HumanoidRootPart")
                    if root then
                        for _, obj in ipairs(workspace:GetDescendants()) do
                            if obj.Name == "Donut" then
                                local part = obj:IsA("BasePart") and obj or obj:IsA("Model") and obj.PrimaryPart
                                if part then
                                    root.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.05)
                                end
                            end
                        end
                    end
                end)
            end
            task.wait(0.1)
        end
    end)
end

local function StartAntiAfk()
    task.spawn(function()
        while true do
            if getgenv().Evade_Event.AntiAfk then
                pcall(function()
                    VirtualUser:Button2Down(Vector2.new(0, 0), CFrame.new())
                    task.wait(15)
                    VirtualUser:Button2Up(Vector2.new(0, 0), CFrame.new())
                end)
            end
            task.wait(15)
        end
    end)
end

StartAutoGetBike()
StartAutoCollectDonut()
StartAntiAfk()

task.spawn(function()
    while task.wait(0.1) do
        if getgenv().Evade_Event.AutoGetBike then
        end
        if getgenv().Evade_Event.AutoCollectDonut then
        end
        if getgenv().Evade_Event.AntiAfk then
        end
    end
end)

getgenv().Evade_Event.AutoGetBike = true
getgenv().Evade_Event.AutoCollectDonut = true
getgenv().Evade_Event.AntiAfk = true
