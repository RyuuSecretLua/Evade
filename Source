local function GetVisualFolder()
    local g = workspace:FindFirstChild("Game")
    if not g then return nil end
    local e = g:FindFirstChild("Effects")
    if not e then return nil end
    local t = e:FindFirstChild("Tickets")
    if not t then return nil end
    return t:FindFirstChild("Visual")
end

local function TeleportTo(part)
    pcall(function()
        Character = LocalPlayer.Character
        HRP = Character and Character:FindFirstChild("HumanoidRootPart")
        if HRP then
            HRP.CFrame = part.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end

local function CollectAll()
    local folder = GetVisualFolder()
    if not folder then return end
    for _, ticket in ipairs(folder:GetChildren()) do
        if not AutoCollect then break end
        local part = ticket:IsA("BasePart") and ticket or ticket:FindFirstChildWhichIsA("BasePart")
        if part then
            TeleportTo(part)
            task.wait(0.1)
        end
    end
end

local function GetBees()
    local bees = {}
    local g = workspace:FindFirstChild("Game")
    if not g then return bees end
    local p = g:FindFirstChild("Players")
    if not p then return bees end
    local bee = p:FindFirstChild("Bee")
    if not bee then return bees end
    for _, v in ipairs(bee:GetChildren()) do
        local hrp = v:FindFirstChild("HumanoidRootPart")
        if hrp then
            table.insert(bees, hrp)
        end
    end
    return bees
end

local function StartAutoAvoid()
    if Threads.AutoAvoid then return end
    Threads.AutoAvoid = true
    task.spawn(function()
        local SAFE_DISTANCE = 80
        local lastTP = 0
        while Threads.AutoAvoid do
            if not AutoAvoid then break end
            task.wait()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then continue end

            local closest, dist = nil, math.huge
            for _, obj in pairs(workspace.Game.Players:GetChildren()) do
                if not Players:FindFirstChild(obj.Name) then
                    local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChildWhichIsA("BasePart")
                    if part then
                        local d = (root.Position - part.Position).Magnitude
                        if d < dist then
                            dist = d
                            closest = part
                        end
                    end
                end
            end

            if closest and dist < SAFE_DISTANCE and tick() - lastTP > 0.2 then
                local dir = (root.Position - closest.Position).Unit
                local pos = root.Position + dir * 60
                lastTP = tick()
                root.CFrame = CFrame.new(pos)
            end
        end
        Threads.AutoAvoid = nil
    end)
end

Main:AddToggle({
    Name = "Auto Collect Ticket",
    Default = false,
    Callback = function(state)
        AutoCollect = state
        if state then
            Window:AddNotify({
                UseIcon = false,
                Title = "Evade [Spring Event]",
                Text = "Auto Collect Ticket Enabled!",
                StartedNotify = 0.5,
                EndedNotify = 4
            })
            CollectLoop = task.spawn(function()
                while AutoCollect do
                    CollectAll()
                    task.wait(0.1)
                end
            end)
            local folder = GetVisualFolder()
            if folder then
                SpawnConnection = folder.ChildAdded:Connect(function(child)
                    if not AutoCollect then return end
                    task.wait()
                    local part = child:IsA("BasePart") and child or child:FindFirstChildWhichIsA("BasePart")
                    if part then
                        TeleportTo(part)
                    end
                end)
            end
        else
            Window:AddNotify({
                UseIcon = false,
                Title = "Evade [Spring Event]",
                Text = "Auto Collect Ticket Disabled!",
                StartedNotify = 0.5,
                EndedNotify = 4
            })
            if CollectLoop then
                task.cancel(CollectLoop)
                CollectLoop = nil
            end
            if SpawnConnection then
                SpawnConnection:Disconnect()
                SpawnConnection = nil
            end
        end
    end
})

